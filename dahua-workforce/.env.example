# Copier en `.env` (non versionné) et renseigner. Aucun secret dans le YAML.

# Comptes caméra — dédiés, en lecture seule, distincts de `admin`.
CAM_LIGNE_A_PASSWORD=
CAM_LIGNE_B_PASSWORD=

# WhatsApp Business Cloud API.
# Token permanent via un utilisateur système : le token de test expire en 24 h.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

TZ=Africa/Algiers
